{
  "name": "limosyn.com",
  "description": "The personal website and online blog of Somil Singhai, a budding developer",
  "version": "0.0.1",
  "packageManager": "yarn@1.22.22",
  "author": {
    "name": "Somil Singhai",
    "email": "somil@limosyn.com",
    "url": "https://limosyn.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:limosin/website.git"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src next.config.js scripts",
    "validate": "yarn lint && yarn typecheck && yarn test",
    "analyze": "ANALYZE=true yarn build",
    "lighthouse": "lhci autorun",
    "cache:stats": "tsx scripts/cache-manager.js stats",
    "cache:clear": "tsx scripts/cache-manager.js clear",
    "cache:clear-expired": "tsx scripts/cache-manager.js clear-expired",
    "cache:warm": "tsx scripts/cache-manager.js warm"
  },
  "dependencies": {
    "@notionhq/client": "^5.9.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.9",
    "autoprefixer": "^10.4.14",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "prismjs": "^1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reading-time": "1.5.0",
    "tailwindcss": "4.3.3",
    "web-vitals": "^5.0.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "16.3.0",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "^16.0.10",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-tailwindcss": "^3.11.0",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tsx": "^4.23.12",
    "typescript": "^5.0.4",
    "vitest": "^4.1.10",
    "webpack-bundle-analyzer": "^5.1.0"
  }
}
